# InsightDesk Backend — Environment Configuration
# Copy this file to .env and fill in the values.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local development (PostgreSQL running locally or via Docker):
# DATABASE_URL=postgresql://insightdesk:insightdesk_dev@localhost:5432/insightdesk

# Supabase (production):
# DATABASE_URL=postgresql://postgres:<password>@<host>.supabase.co:5432/postgres

DATABASE_URL=postgresql://insightdesk:insightdesk_dev@localhost:5432/insightdesk

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local development:
ALLOWED_ORIGINS=http://localhost:5173

# Production (update after Phase 8 deployment):
# ALLOWED_ORIGINS=https://insightdesk.vercel.app
