# Handle line endings consistently across platforms
* text=auto

# Python files — keep LF
*.py text eol=lf

# JS/JSX/JSON/CSS/HTML — keep LF
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary — do not modify
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary
